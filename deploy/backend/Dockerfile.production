FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN groupadd --gid 10001 app \
    && useradd --uid 10001 --gid app --create-home --shell /usr/sbin/nologin app

WORKDIR /app
COPY backend/requirements/base.txt /app/backend/requirements/base.txt
RUN python -m pip install --no-cache-dir -r /app/backend/requirements/base.txt

COPY backend /app/backend
COPY deploy/backend/entrypoint.production.sh /entrypoint.production.sh
RUN chmod +x /entrypoint.production.sh \
    && chown -R app:app /app /entrypoint.production.sh

USER app
WORKDIR /app/backend
EXPOSE 8000

ENTRYPOINT ["/entrypoint.production.sh"]
CMD ["gunicorn", "config.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "2", "--access-logfile", "-", "--error-logfile", "-"]

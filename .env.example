# 仅用于本地开发。复制为 .env 后必须按本机环境调整，禁止用于生产。
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=development-only-change-me
# 生产密钥必须在仓库外独立生成并通过环境注入，不要在本文件填写真实值：
# JWT_SIGNING_KEY=<generate-at-least-32-random-bytes>
# ACCOUNT_TOKEN_HMAC_ACTIVE_KID=<key-id>
# ACCOUNT_TOKEN_HMAC_KEYS_JSON={"<key-id>":"<generate-random-secret>"}
# AUDIT_ARCHIVE_HMAC_ACTIVE_KID=<key-id>
# AUDIT_ARCHIVE_HMAC_KEYS_JSON={"<key-id>":"<generate-random-secret>"}
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,10.0.2.2
CORS_ALLOWED_ORIGINS=http://localhost:3000
DJANGO_API_DOCS_ENABLED=true

POSTGRES_DB=employee_management
POSTGRES_USER=employee_app
POSTGRES_PASSWORD=development-only-change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

REDIS_URL=redis://127.0.0.1:6379/0

DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=127.0.0.1
DJANGO_EMAIL_PORT=1025
DJANGO_DEFAULT_FROM_EMAIL=no-reply@example.invalid

AUDIT_RETENTION_DAYS=0
AUDIT_EXPORT_MAX_ROWS=10000
